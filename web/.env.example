# BidPilot environment variables (no secrets committed)

# Supabase project (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (required for the AI worker pipeline; never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (required for production AI; app falls back to a
# clearly-labeled MOCK AI MODE when absent)
GEMINI_API_KEY=

# Stripe (required for real payments; app falls back to a clearly-labeled
# MOCK PAYMENT MODE when absent)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (optional)
RESEND_API_KEY=

# Absolute URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000
