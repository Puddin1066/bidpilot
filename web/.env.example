# BidPilot environment variables (no secrets committed)

# Supabase project (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (required for admin/XPRIZE exports and webhooks;
# the customer job pipeline uses the session client and works without it)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (required for production AI; app falls back to a
# clearly-labeled MOCK AI MODE when absent)
GEMINI_API_KEY=

# Stripe — leave empty to run labeled MOCK PAYMENT MODE (no charges; mock
# purchases never enter arms-length revenue). Add live keys when ready for
# real customers; the product is complete end-to-end without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (optional)
RESEND_API_KEY=

# Absolute URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000
